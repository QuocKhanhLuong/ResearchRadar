# Discord (required only to launch the bot)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Storage
DATABASE_URL=sqlite:///data/research_radar.db

# Scholarly providers (optional where anonymous access is supported)
OPENALEX_EMAIL=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Scheduling
WATCH_SCAN_HOURS=6
DIGEST_HOUR=8
TIMEZONE=Asia/Bangkok

# Model inference (mock is safe for local setup and tests)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
HTTP_TIMEOUT_SECONDS=20

# Artifact storage (PDF bytes, extracted text, section JSON)
ARTIFACT_ROOT=data/artifacts

# Local embeddings for derived semantic retrieval
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Derived semantic index (rebuildable from SQLite; never canonical)
SEMANTIC_INDEX=disabled
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=research-radar

# Bounded metadata ingestion
INGESTION_METADATA_LIMIT=50
