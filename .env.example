# ResearchRadar environment template.
# Copy to .env and fill in only what your setup needs. Never commit real values.

# ---------------------------------------------------------------------------
# Discord
# Required only to launch the bot; chat features are unusable without a token.
# ---------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Owner-only admission filter (empty = no owner restriction).
DISCORD_OWNER_USER_ID=
# CSV of channel ids permitted for mention chat (empty = all channels allowed).
DISCORD_ALLOWED_CHANNEL_IDS=
# Reply when the bot is mentioned in a channel.
DISCORD_CHAT_ON_MENTION=true
# Reply to direct messages sent to the bot.
DISCORD_DM_CHAT=true

# ---------------------------------------------------------------------------
# Storage
# Required for any persistence; SQLite is the canonical store.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/research_radar.db

# ---------------------------------------------------------------------------
# Scholarly providers
# Optional; anonymous OpenAlex/arXiv access works without keys.
# ---------------------------------------------------------------------------
OPENALEX_EMAIL=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# ---------------------------------------------------------------------------
# LLM / GoRouter
# Required for synthesis and chat; LLM_PROVIDER=mock works fully offline.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
HTTP_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Embeddings
# Optional; needed only for local semantic retrieval.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Pinecone
# Optional; derived semantic index only, never required.
# ---------------------------------------------------------------------------
SEMANTIC_INDEX=disabled
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=research-radar

# ---------------------------------------------------------------------------
# Personal memory
# Optional; USER_MEMORY_BACKEND=disabled keeps chat fully functional.
# Requires `pip install -e ".[memory]"` when set to graphiti.
# ---------------------------------------------------------------------------
USER_MEMORY_BACKEND=disabled
USER_MEMORY_DB_PATH=data/user_memory
USER_MEMORY_GROUP_ID=primary-user
USER_MEMORY_MAX_RESULTS=8
USER_MEMORY_CAPTURE=true

# ---------------------------------------------------------------------------
# Research ingestion
# Optional bounds on metadata ingestion and live discovery per run.
# ---------------------------------------------------------------------------
INGESTION_METADATA_LIMIT=50
CHAT_LIVE_DISCOVERY_LIMIT=10

# ---------------------------------------------------------------------------
# Scheduler
# Optional; watch/digest cadence for the background scheduler.
# ---------------------------------------------------------------------------
WATCH_SCAN_HOURS=6
DIGEST_HOUR=8
TIMEZONE=Asia/Bangkok
